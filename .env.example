# Solari API key — one key across browsers, sandboxes, and desktops.
# Get one at https://console.getsolari.com
SOLARI_API_KEY=

# Fake vendor portal (deterministic twin world; no third-party sites are hit).
NOAPI_PORTAL_ORIGIN=http://127.0.0.1:8787
NOAPI_PORTAL_USER=reviewer@getsolari.com
NOAPI_PORTAL_PASSWORD=reviewer

# Optional: LLM planner (OFF by default; the static JSON planner steers the demo).
# OPENAI_API_KEY=
